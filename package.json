{
  "name": "cosync",
  "version": "0.1.0",
  "description": "Real-time collaborative text editing backend built on a from-scratch sequence CRDT",
  "license": "MIT",
  "author": "Nikita Rybak",
  "type": "module",
  "main": "dist/src/main.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:client",
    "build:client": "tsc -p client/tsconfig.json",
    "dev": "npm run build:client && tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
