HOST=0.0.0.0
PORT=3000
DB_PATH=./data/cosync.db
LOG_LEVEL=info
LOG_PRETTY=false

# Protocol limits
MAX_MESSAGE_BYTES=262144
MAX_OPS_PER_MESSAGE=5000
BACKPRESSURE_HIGH_WATER_BYTES=4194304
PRESENCE_DROP_WATER_BYTES=262144

# Presence
HEARTBEAT_MS=5000
PRESENCE_TIMEOUT_MS=15000

# Documents and persistence
SNAPSHOT_EVERY_OPS=500
IDLE_UNLOAD_MS=30000
TICK_MS=1000
REPLICA_TTL_MS=604800000
SHUTDOWN_GRACE_MS=10000
